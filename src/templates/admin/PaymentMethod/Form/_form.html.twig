{% set form = hookable_metadata.context.form %}

<div class="card" data-controller="calculator">
	<div class="card-body">
		<h4 class="card-title">{{ 'sylius.ui.taxes'|trans }}</h4>
		{{ form_row(form.taxCategory) }}

		<h4 class="card-title mt-4">{{ 'threebrs.ui.payment_charges'|trans }}</h4>
		{{ form_row(form.calculator) }}

		{% for name, calculatorConfigurationPrototype in form.vars.prototypes %}
			<div id="{{ form.calculator.vars.id }}_{{ name }}" data-target="calculator.container" data-prototype="{{ form_widget(calculatorConfigurationPrototype)|e }}"></div>
		{% endfor %}

		<div class="calculatorConfiguration mt-3" data-target="calculator.calculatorConfiguration" style="display: none;">
			{% if form.calculatorConfiguration is defined %}
				{% for field in form.calculatorConfiguration %}
					<div class="mb-3">
						{{ form_row(field) }}
					</div>
				{% endfor %}
			{% endif %}
		</div>
	</div>
</div>
